[Unit]
Description=conv-app API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/conv-app/apps/api
EnvironmentFile=/home/ubuntu/apps/conv-app/apps/api/.env
ExecStart=/home/ubuntu/apps/conv-app/apps/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8004 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
