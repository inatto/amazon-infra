<section class="console" aria-live="polite">
  <div class="console-head">
    <div>
      <p class="eyebrow">ORBITAL INFRASTRUCTURE CONTROL</p>
      <h1>Servidor <span id="hostname">carregando</span></h1>
    </div>
    <div class="master-status">
      <span id="master-led" class="led warning"></span>
      <strong id="master-label">SINCRONIZANDO</strong>
    </div>
  </div>

  <div class="telemetry">
    <article><span>CPU LOAD</span><strong id="load">—</strong></article>
    <article><span>MEMÓRIA</span><strong id="memory">—</strong></article>
    <article><span>DISCO</span><strong id="disk">—</strong></article>
    <article><span>UPTIME</span><strong id="uptime">—</strong></article>
  </div>

  <div class="radar-shell">
    <div class="radar"><span></span><i></i></div>
    <div class="radar-copy">
      <span>VARREDURA ATIVA</span>
      <strong id="checked-at">aguardando telemetria</strong>
      <small>Dados reais do systemd, sockets e endpoints locais · atualização a cada 10 segundos</small>
    </div>
  </div>

  <div id="systems" class="systems"></div>
</section>

<script define:vars={{ apiUrl: import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:8005' }}>
  const systems = document.querySelector('#systems');
  const masterLed = document.querySelector('#master-led');
  const masterLabel = document.querySelector('#master-label');

  const formatUptime = (seconds) => {
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    return `${days}d ${hours}h`;
  };

  const escapeHtml = (value) => String(value ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

  const checkHtml = (item) => `
    <article class="check ${escapeHtml(item.status)}">
      <span class="led ${escapeHtml(item.status)}"></span>
      <div>
        <strong>${escapeHtml(item.name)}</strong>
        <small>${escapeHtml(item.kind)} · ${escapeHtml(item.detail)}</small>
      </div>
      <b>${item.latency_ms == null ? item.status.toUpperCase() : `${item.latency_ms} ms`}</b>
    </article>`;

  const groupHtml = (group) => `
    <section class="system-group ${escapeHtml(group.status)}">
      <header class="system-head">
        <div>
          <p>${escapeHtml(group.type)}</p>
          <h2><span class="led ${escapeHtml(group.status)}"></span>${escapeHtml(group.name)}</h2>
          <small>${group.domains.map(escapeHtml).join(' · ') || 'sem domínio publicado'}</small>
        </div>
        <strong>${escapeHtml(group.status.toUpperCase())}</strong>
      </header>
      <div class="checks">${group.checks.map(checkHtml).join('')}</div>
    </section>`;

  const render = (data) => {
    document.querySelector('#hostname').textContent = data.system.hostname;
    document.querySelector('#load').textContent = data.system.load.join(' / ');
    document.querySelector('#memory').textContent = `${data.system.memory.used_percent}%`;
    document.querySelector('#disk').textContent = `${data.system.disk.used_percent}%`;
    document.querySelector('#uptime').textContent = formatUptime(data.system.uptime_seconds);
    document.querySelector('#checked-at').textContent = new Date(data.checked_at).toLocaleString('pt-BR');

    const isOk = data.status === 'ok';
    masterLed.className = `led ${isOk ? 'ok' : 'error'}`;
    masterLabel.textContent = isOk ? 'SISTEMAS NOMINAIS' : 'ALERTA DETECTADO';

    const oracle = {
      id: 'oracle', name: 'Oracle Database', type: 'database', domains: [],
      status: data.oracle.status === 'disabled' ? 'disabled' : data.oracle.status,
      checks: [{ name: 'Oracle Database', kind: 'database', status: data.oracle.status, detail: data.oracle.detail, latency_ms: null }],
    };
    systems.innerHTML = [...data.groups, oracle].map(groupHtml).join('');
  };

  const load = async () => {
    try {
      const response = await fetch(`${apiUrl}/api/monitor`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      render(await response.json());
    } catch (error) {
      masterLed.className = 'led error';
      masterLabel.textContent = 'API INDISPONÍVEL';
      systems.innerHTML = `<article class="check error"><span class="led error"></span><div><strong>Monitor API</strong><small>${escapeHtml(error.message)}</small></div><b>ERROR</b></article>`;
    }
  };

  load();
  setInterval(load, 10000);
</script>
