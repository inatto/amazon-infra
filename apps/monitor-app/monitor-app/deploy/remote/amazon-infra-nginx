#!/usr/bin/env bash
set -Eeuo pipefail

ACTION="${1:-}"
DOMAIN="${2:-}"
TARGET="${3:-}"
SSL_EMAIL="${4:-}"
SSL_FLAG="${5:-}"

fail() { echo "ERRO: $*" >&2; exit 1; }
[[ "$ACTION" == "apply-redirect" ]] || fail "ação não permitida"
[[ "$DOMAIN" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || fail "domínio inválido"
[[ "$TARGET" =~ ^https?://[^[:space:]\;\{\}]+$ ]] || fail "destino inválido"
[[ "$SSL_EMAIL" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || fail "e-mail SSL inválido"
[[ -z "$SSL_FLAG" || "$SSL_FLAG" == "--ssl" ]] || fail "flag inválida"

AVAILABLE="/etc/nginx/sites-available/$DOMAIN"
ENABLED="/etc/nginx/sites-enabled/$DOMAIN"
TMP="$(mktemp)"
BACKUP="$(mktemp)"
HAD_PREVIOUS=false

cleanup() { rm -f "$TMP" "$BACKUP"; }
rollback() {
  status=$?
  trap - ERR
  if [[ "$HAD_PREVIOUS" == true ]]; then
    install -m 0644 "$BACKUP" "$AVAILABLE"
    ln -sfn "$AVAILABLE" "$ENABLED"
  else
    rm -f "$AVAILABLE" "$ENABLED"
  fi
  nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
  cleanup
  exit "$status"
}
trap rollback ERR
trap cleanup EXIT

nginx -t
systemctl is-active --quiet nginx
if [[ -f "$AVAILABLE" ]]; then
  cp -a "$AVAILABLE" "$BACKUP"
  HAD_PREVIOUS=true
fi

write_http() {
cat > "$TMP" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;

    return 301 $TARGET;
}
NGINX
}

write_https() {
cat > "$TMP" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;

    return 301 $TARGET;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $DOMAIN;

    ssl_certificate /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 $TARGET;
}
NGINX
}

if [[ -s "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" && -s "/etc/letsencrypt/live/$DOMAIN/privkey.pem" ]]; then
  write_https
else
  write_http
fi
install -m 0644 "$TMP" "$AVAILABLE"
ln -sfn "$AVAILABLE" "$ENABLED"
nginx -t
systemctl reload nginx

if [[ "$SSL_FLAG" == "--ssl" && ! -s "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]]; then
  command -v certbot >/dev/null || fail "certbot não instalado"
  certbot certonly --nginx --non-interactive --agree-tos --email "$SSL_EMAIL" -d "$DOMAIN"
  write_https
  install -m 0644 "$TMP" "$AVAILABLE"
  nginx -t
  systemctl reload nginx
fi

echo "OK: $DOMAIN -> $TARGET"
if [[ -s "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]]; then
  echo "SSL: ativo"
else
  echo "SSL: não emitido"
fi
