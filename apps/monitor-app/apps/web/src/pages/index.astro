---
import Layout from '../layouts/Layout.astro';
import StatusPanel from '../components/StatusPanel.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL ?? '/api';
const incomingCookie = Astro.request.headers.get('cookie') ?? '';
let sessionStatus = 503;

try {
  const sessionResponse = await fetch('http://127.0.0.1:8005/api/auth/session', {
    headers: incomingCookie ? { cookie: incomingCookie } : {},
    redirect: 'manual',
  });
  sessionStatus = sessionResponse.status;
} catch {
  sessionStatus = 503;
}

if (sessionStatus === 401) {
  return Astro.redirect(`${apiUrl}/api/auth/login`, 302);
}
if (sessionStatus === 403) {
  return new Response('Acesso restrito ao ambiente de desenvolvimento.', { status: 403 });
}
if (sessionStatus !== 200) {
  return new Response('Autenticação do Monitor indisponível.', { status: 503 });
}
---
<Layout>
  <main>
    <header class="topbar">
      <div class="brand"><span class="brand-mark">A</span><div><strong>AMAZON INFRA</strong><small>CONTROL v0.0.7</small></div></div>
      <div class="topbar-right"><span class="environment-dot"></span><span class="secure">EC2 · NGINX · SYSTEMD · HTTP</span></div>
    </header>
    <StatusPanel />
    <footer>INATTO · INFRASTRUCTURE CONTROL SYSTEM</footer>
  </main>
</Layout>
