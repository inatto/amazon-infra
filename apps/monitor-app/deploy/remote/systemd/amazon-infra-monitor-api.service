[Unit]
Description=Amazon Infra Monitor API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/infra/monitor-app/apps/api
EnvironmentFile=/home/ubuntu/apps/infra/monitor-app/apps/api/.env
ExecStart=/home/ubuntu/apps/infra/monitor-app/apps/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8005 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
