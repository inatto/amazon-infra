[Unit]
Description=inst-app-anpprev Astro Web
After=network-online.target inst-app-anpprev-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/inst-app-anpprev/apps/web
EnvironmentFile=/home/ubuntu/apps/inst-app-anpprev/apps/web/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4100
ExecStart=/usr/bin/node /home/ubuntu/apps/inst-app-anpprev/apps/web/dist/server/entry.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
