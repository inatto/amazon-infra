[Unit]
Description=orbital-app Note Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/orbital/orbital-app/apps/api
EnvironmentFile=/home/ubuntu/apps/orbital/orbital-app/apps/api/.env
ExecStart=/usr/bin/bash -lc 'export ORACLE_POOL_SIZE="${ORACLE_NOTE_WORKER_POOL_SIZE:-1}"; export ORACLE_POOL_MAX_OVERFLOW=0; exec /home/ubuntu/apps/orbital/orbital-app/apps/api/.venv/bin/python -m workers.note_send_worker'
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
