server {
    listen 80;
    listen [::]:80;
    server_name admin.asaclub.org.br;

    return 301 https://admin.sindicatto.com/login/asaclub;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name admin.asaclub.org.br;

    ssl_certificate /etc/letsencrypt/live/admin.asaclub.org.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.asaclub.org.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://admin.sindicatto.com/login/asaclub;
}
