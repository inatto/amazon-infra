[Unit]
Description=Orbital Astro Web
After=network-online.target orbital-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/orbital-app/current/apps/web
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4001
ExecStart=/usr/bin/node /home/ubuntu/apps/orbital-app/current/apps/web/dist/server/entry.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
