[Unit]
Description=Orbital API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/orbital/current/services/api
EnvironmentFile=/home/ubuntu/apps/orbital/shared/services/api/.env
ExecStart=/home/ubuntu/apps/orbital/current/services/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8004 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
