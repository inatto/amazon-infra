[Unit]
Description=Orbital API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/orbital-app/services/api
EnvironmentFile=/home/ubuntu/apps/orbital-app/services/api/.env
ExecStart=/home/ubuntu/apps/orbital-app/services/api/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT} --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
