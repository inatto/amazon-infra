[Unit]
Description=Site Inst ANPPREV API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/site-inst-anpprev/services/api
EnvironmentFile=/home/ubuntu/apps/site-inst-anpprev/deploy/tenants/anpprev/anpprev.env
ExecStart=/home/ubuntu/apps/site-inst-anpprev/services/api/.venv/bin/uvicorn app.main:app --host ${LINK_CHECK_API_HOST} --port ${LINK_CHECK_API_PORT} --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
