[Unit]
Description=Site Inst API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/site-inst/services/api
EnvironmentFile=/home/ubuntu/apps/site-inst/.env
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8003
ExecStart=/home/ubuntu/apps/site-inst/services/api/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT} --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
