[Unit]
Description=Sindicatto API FastAPI
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/sindicatto/services
EnvironmentFile=/home/ubuntu/sindicatto/services/.env

ExecStart=/home/ubuntu/sindicatto/services/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target