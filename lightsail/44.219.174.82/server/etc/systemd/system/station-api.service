[Unit]
Description=Station API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/station-app/apps/api
EnvironmentFile=/home/ubuntu/apps/station-app/apps/api/.env
ExecStart=/home/ubuntu/apps/station-app/apps/api/.venv/bin/uvicorn main:app --host ${APP_HOST} --port ${APP_PORT} --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
