#!/usr/bin/env bash
# cd /home/daniel/Code/sind-infra/sind-amazon/lightsail/44.219.174.82
# DESATIVADO: substituído por deploy/05_IMPORTANTE_nginx_backup.sh.
set -e

REMOTE_USER="ubuntu"
REMOTE_HOST="44.219.174.82"
SSH_KEY="/home/daniel/amazon.ssh"

#deve ser relativo a este arquivo
LOCAL_BACKUP_DIR="/home/daniel/Code/sind-infra/sind-amazon/lightsail/44.219.174.82/server/etc/nginx"

mkdir -p "$LOCAL_BACKUP_DIR"

echo "Fazendo backup remoto de /etc/nginx/"
echo "Servidor: $REMOTE_USER@$REMOTE_HOST"
echo "Destino local: $LOCAL_BACKUP_DIR"
echo ""

rsync -avz --delete \
  --no-owner \
  --no-group \
  --exclude "sites-enabled/" \
  --exclude "modules-enabled/" \
  -e "ssh -i $SSH_KEY -o ServerAliveInterval=30 -o ServerAliveCountMax=120 -o TCPKeepAlive=yes" \
  --rsync-path="sudo rsync" \
  "$REMOTE_USER@$REMOTE_HOST:/etc/nginx/" \
  "$LOCAL_BACKUP_DIR/"

echo ""
echo "Backup concluído."
echo ""
echo "Ignorados:"
echo "- sites-enabled/"
echo "- modules-enabled/"
