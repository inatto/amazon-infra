#!/usr/bin/env bash
# cd /home/daniel/Code/sind-infra/sind-amazon/lightsail/44.219.174.82
# DESATIVADO: hardcoded para sinproprev.org.br e substituído pelo publicador seguro.
set -e

REMOTE_USER="ubuntu"
REMOTE_HOST="44.219.174.82"
SSH_KEY="/home/daniel/amazon.ssh"

#DOMAIN="sinproprev.sindicatto.com"
DOMAIN="sinproprev.org.br"
EMAIL="danielmaiax@gmail.com"

SSH_OPTS="-i $SSH_KEY -o ServerAliveInterval=30 -o ServerAliveCountMax=120 -o TCPKeepAlive=yes"

echo "Configurando SSL para: $DOMAIN"
echo "Servidor: $REMOTE_USER@$REMOTE_HOST"
echo ""

echo "Testando Nginx remoto antes do Certbot..."

ssh $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "
  set -e
  sudo nginx -t
"

echo ""
echo "Verificando Certbot..."

ssh $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "
  set -e

  if ! command -v certbot >/dev/null 2>&1; then
    echo 'Certbot não encontrado. Instalando...'

    sudo apt update
    sudo apt install -y snapd

    sudo snap install core || true
    sudo snap refresh core || true
    sudo snap install --classic certbot || true

    sudo ln -sf /snap/bin/certbot /usr/bin/certbot
  else
    echo 'Certbot já instalado.'
  fi
"

echo ""
echo "Gerando certificado SSL para $DOMAIN..."

ssh $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "
  set -e

  sudo certbot --nginx \
    -d '$DOMAIN' \
    --redirect \
    --agree-tos \
    -m '$EMAIL' \
    --no-eff-email
"

echo ""
echo "Testando renovação automática..."

ssh $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "
  set -e
  sudo certbot renew --dry-run
"

echo ""
echo "Testando e recarregando Nginx..."

ssh $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "
  set -e
  sudo nginx -t
  sudo systemctl reload nginx
"

echo ""
echo "SSL configurado com sucesso:"
echo "https://$DOMAIN"
